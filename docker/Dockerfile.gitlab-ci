ARG OS_DISTRO=oraclelinux
ARG OS_RELEASE=10

FROM $OS_DISTRO:$OS_RELEASE AS default

ARG USER=root
ARG GROUP=root
ARG USERID=0
ARG GROUPID=0

RUN cp /etc/skel/.bash_profile /root && \
    cp /etc/skel/.bashrc /root


RUN dnf install sudo; \
    if [ $USERID != 0 ]; then \
        groupadd -g $GROUPID $GROUP; \
        useradd -u $USERID -g $GROUP $USER; \
        echo "$USER ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/$USER; \
        chmod 440 /etc/sudoers.d/$USER; \
    fi

USER $USERID:$GROUPID

COPY prepare-machine /prepare-machine
COPY shell.nix /shell.nix

RUN /prepare-machine dev-docker && \
    sudo dnf clean all && \
    sudo rm -rf /var/cache/dnf/

ENTRYPOINT ["/bin/bash", "-l", "-c"]
